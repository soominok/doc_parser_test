# ─────────────────────────────────────────────────────────────
# .env.example
# 실제 사용 시 이 파일을 .env로 복사하고 값을 입력하세요.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────

# LLM 제공자 선택: "openai" | "anthropic" | "none" (기본값: none)
# "none"으로 설정하면 LLM 기능을 사용하지 않습니다.
LLM_PROVIDER=none

# OpenAI 설정 (LLM_PROVIDER=openai 일 때 필요)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic 설정 (LLM_PROVIDER=anthropic 일 때 필요)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6
